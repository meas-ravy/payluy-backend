# ── Required ────────────────────────────────────────────────
# Postgres (Neon pooled URL on Vercel). Used by the app and by `prisma migrate`.
DATABASE_URL=
# Google OAuth (dashboard sign-in). Allowed redirect URI in Google Console: <PUBLIC_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random chars, the app refuses to boot otherwise: openssl rand -base64 48
SESSION_SECRET=

# ── URLs (defaults are for local dev) ───────────────────────
# This backend. Unset: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3001
PUBLIC_ORIGIN=
# The dashboard: CORS allowlist + where sign-in lands. Default http://localhost:3000. Required on Vercel.
FRONTEND_URL=
DATABASE_URL_UNPOOLED=
