# Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
# Postgres 16. Tests need a separate DB whose name contains "test".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/Payluy?schema=public"

# --- Server ---
PORT=3001
# Public URL of this backend: used for checkout_url, the Google redirect URI and the cookie's Secure flag.
PUBLIC_ORIGIN=http://localhost:3001
# The Next.js dashboard: CORS allowlist and where Google sign-in lands (/dashboard).
FRONTEND_URL=http://localhost:3000
# Shown on the hosted checkout page.
PRODUCT_NAME="[Product name]"

# --- Dashboard session (required: the app refuses to boot without it) ---
# 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Google OAuth (dashboard login) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: {PUBLIC_ORIGIN}/auth/google/callback → http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed (npx prisma db seed) ---
# Email of the dev account the seed creates.
SEED_EMAIL=dev@example.com
