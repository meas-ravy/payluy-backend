# ── Required ────────────────────────────────────────────────
# Postgres (Neon pooled URL on Vercel). Used by the app and by `prisma migrate`.
DATABASE_URL=
# 32+ random chars, the app refuses to boot otherwise: openssl rand -base64 48
# Signs the dashboard session token. Backend only: the dashboard never needs it.
SESSION_SECRET=
# 32+ random chars, the app refuses to boot otherwise: openssl rand -base64 48
# Shared with the dashboard's Next.js server (same value there): it authenticates POST /internal/auth/google.
INTERNAL_API_SECRET=
# Google sign-in now runs in the dashboard (NextAuth): GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET live there, not here.

# ── URLs (defaults are for local dev) ───────────────────────
# This backend, used in checkout_url. Unset: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3001
PUBLIC_ORIGIN=
# The dashboard: CORS allowlist. Default http://localhost:3000.
FRONTEND_URL=
DATABASE_URL_UNPOOLED=
